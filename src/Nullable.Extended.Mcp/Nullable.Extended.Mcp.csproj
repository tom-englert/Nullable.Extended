<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Nullable.Extended.Mcp</RootNamespace>
    <IsDeploymentTarget>true</IsDeploymentTarget>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nullable-extended-mcp</ToolCommandName>
    <PackageId>Nullable.Extended.Mcp</PackageId>
    <PackageType>McpServer</PackageType>
    <Description>MCP server to find, review and justify null-forgiving operators in large C# code bases.</Description>
    <PackageTags>nullable;null-forgiving;mcp;roslyn</PackageTags>
    <Authors>tom-englert.de</Authors>
    <Copyright>(c) 2020, tom-englert.de</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/tom-englert/Nullable.Extended</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tom-englert/Nullable.Extended</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>package_icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Label="PackageReferences">
    <!-- The server parses the latest C# syntax, so it needs a current Roslyn, not the old one the core library is compiled against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(TestRoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(TestRoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="$(TestRoslynVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="TomsToolbox.Composition.MicrosoftExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nullable.Extended\Nullable.Extended.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="false" />
    <None Include="..\package_icon.png" Link="package_icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- .mcp\server.json is a template; the packed copy gets the package version, which must match the package for the MCP clients. -->
  <Target Name="GenerateMcpServerJson" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_McpServerJson>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)mcp\server.json</_McpServerJson>
      <_McpServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json').Replace('$version$', '$(PackageVersion)').TrimEnd())</_McpServerJsonContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_McpServerJson)" Lines="$([MSBuild]::Escape($(_McpServerJsonContent)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_McpServerJson)" Pack="true" PackagePath="/.mcp/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
