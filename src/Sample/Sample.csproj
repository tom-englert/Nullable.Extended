<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Suppress the intentional nullable warnings in regular builds; the unit test sets AnalyzeSample=true. -->
  <PropertyGroup Condition="'$(AnalyzeSample)' != 'true'">
    <NoWarn>$(NoWarn);CS0649;CS8602;CS8604</NoWarn>
  </PropertyGroup>

</Project>
